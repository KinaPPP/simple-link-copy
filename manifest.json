{
  "manifest_version": 3,
  "name": "シンプルリンクコピー",
  "description": "ページタイトルとURLをシンプルにコピー",
  "homepage_url": "https://github.com/KinaPPP/simple-link-copy",
  "version": "1.6",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "permissions": ["activeTab", "scripting", "storage", "downloads"],
  "host_permissions": ["https://image.api.playstation.com/*"],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
